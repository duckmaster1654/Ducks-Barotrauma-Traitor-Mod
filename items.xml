        </Throwable>
        <Projectile characterusable="false" launchimpulse="0.0" sticktocharacters="false">
            <Attack structuredamage="5">
                <Affliction identifier="blunttrauma" strength="5" />
                <Affliction identifier="stun" strength="0.5" />
